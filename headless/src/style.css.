:root {
color-scheme: dark;
font-family: Inter, Arial, Helvetica, sans-serif;
background: #090909;
color: #f7f7f7;
font-synthesis: none;
}

* {
box-sizing: border-box;
}

body {
margin: 0;
min-height: 100vh;
background: #090909;
}

.status {
width: min(720px, calc(100% - 40px));
margin: 12vh auto;
padding: 36px;
border: 1px solid rgba(255,255,255,.12);
border-radius: 18px;
background: #151515;
}

.eyebrow {
color: #f97316;
font-weight: 800;
letter-spacing: .18em;
}

h1 {
margin: 12px 0;
font-size: clamp(2rem, 6vw, 3.5rem);
}

p {
color: #c9c9c9;
line-height: 1.7;
}

.note {
color: #f97316;
}
